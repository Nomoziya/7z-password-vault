#include "PasswordPageRes.h"
#include "../../GuiCommon.rc"

#define xc OPTIONS_PAGE_XC_SIZE
#define yc OPTIONS_PAGE_YC_SIZE

IDD_PASSWORD_PAGE  MY_PAGE
BEGIN
  LTEXT    "Vault path (empty = default):", IDT_PASSWORD_VAULT_PATH, m, 12, 226, 8
  EDITTEXT  IDE_PASSWORD_VAULT_PATH, m, 24, 226, 14, ES_AUTOHSCROLL
  PUSHBUTTON "Browse...", IDB_PASSWORD_VAULT_BROWSE, 244, 24, 48, 14

  CONTROL  "Use master password (portable)", IDX_PASSWORD_USE_MASTER, MY_CHECKBOX, m, 48, 292, 10
  CONTROL  "Remember master password this session", IDX_PASSWORD_REMEMBER, MY_CHECKBOX, m, 64, 292, 10
  CONTROL  "Lock the master password after 5 minutes idle", IDX_PASSWORD_AUTOLOCK, MY_CHECKBOX, m, 80, 292, 10
  PUSHBUTTON "Set master password...", IDB_PASSWORD_SET_MASTER, m, 96, 140, 14
  PUSHBUTTON "Clear master password...", IDB_PASSWORD_CLEAR_MASTER, 152, 96, 140, 14

  CONTROL  "Close the window after a saved password was typed in", IDX_PASSWORD_CLOSE_FILL, MY_CHECKBOX, m, 120, 292, 10
  CONTROL  "Type a saved name to fill its password automatically", IDX_PASSWORD_AUTOTYPE, MY_CHECKBOX, m, 136, 292, 10
  CONTROL  "Ask to save passwords that are not in the vault", IDX_PASSWORD_PROMPT_SAVE, MY_CHECKBOX, m, 152, 292, 10
  CONTROL  "Show password by default", IDX_PASSWORD_SHOW_DEFAULT, MY_CHECKBOX, m, 168, 292, 10

  PUSHBUTTON "Export vault...", IDB_PASSWORD_EXPORT, m, 192, 140, 14
  PUSHBUTTON "Import vault...", IDB_PASSWORD_IMPORT, 152, 192, 140, 14

  CONTROL  "Show saved passwords in the list", IDX_PASSWORD_HIDE_LIST, MY_CHECKBOX, m, 214, 292, 10
  CONTROL  "Show password of unnamed entries (easier to find)", IDX_PASSWORD_UNNAMED_PW, MY_CHECKBOX, m, 230, 292, 10

  /* An action, not a setting: the same thing the first-start question offers - shortcuts and
     the "Apps & features" entry for the folder the program runs in right now. */
  PUSHBUTTON "Create shortcuts / register uninstall...", IDB_PASSWORD_SETUP, m, 250, 180, 14
END
