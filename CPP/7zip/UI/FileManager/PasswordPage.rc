#include "PasswordPageRes.h"
#include "../../GuiCommon.rc"

#define xc OPTIONS_PAGE_XC_SIZE
#define yc OPTIONS_PAGE_YC_SIZE

IDD_PASSWORD_PAGE  MY_PAGE
BEGIN
  LTEXT    "Vault path:", IDT_PASSWORD_VAULT_PATH, m, 12, xc, 8
  EDITTEXT  IDE_PASSWORD_VAULT_PATH, m, 24, 226, 14, ES_AUTOHSCROLL
  PUSHBUTTON "Browse...", IDB_PASSWORD_VAULT_BROWSE, 244, 24, 48, 14

  CONTROL  "Use master password", IDX_PASSWORD_USE_MASTER, MY_CHECKBOX, m, 48, xc, 10
  CONTROL  "Remember master password this session", IDX_PASSWORD_REMEMBER, MY_CHECKBOX, m, 64, xc, 10
  PUSHBUTTON "Set master password...", IDB_PASSWORD_SET_MASTER, m, 80, 120, 14

  CONTROL  "Auto-fill the only matching password", IDX_PASSWORD_AUTOFILL, MY_CHECKBOX, m, 102, xc, 10
  CONTROL  "Show password by default", IDX_PASSWORD_SHOW_DEFAULT, MY_CHECKBOX, m, 118, xc, 10
END
